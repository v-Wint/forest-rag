# Copy to .env and fill in. Never commit .env.

# PostgreSQL (used by docker compose and by the app)
POSTGRES_USER=forest
POSTGRES_PASSWORD=change-me
POSTGRES_DB=forest
# Where the app run on the host (uv run) finds the database of compose.dev.yml; in
# docker compose the bot uses the db container instead. 127.0.0.1, not "localhost": that
# may resolve to IPv6 ::1 and hang.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432

# Forest Archive files for a run on the host (default: data/archive in the project root);
# the Docker image carries its own copy
# ARCHIVE_DIR=

# Groq (https://console.groq.com/keys): places documents on the map, answers questions
GROQ_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
