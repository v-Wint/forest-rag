# Copy to .env and fill in. Never commit .env.

# PostgreSQL (used by docker compose and by the app)
POSTGRES_USER=forest
POSTGRES_PASSWORD=change-me
POSTGRES_DB=forest
# 127.0.0.1, not "localhost": that may resolve to IPv6 ::1 and hang.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432

# Folder with the Forest Archive files (default: data/ in the project root)
# DATA_DIR=

# Path to tesseract if it is not on PATH, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
# TESSERACT_CMD=

# Used later
# TELEGRAM_BOT_TOKEN=
# GROQ_API_KEY=
